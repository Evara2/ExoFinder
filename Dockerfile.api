FROM python:3.11-slim
WORKDIR /app
RUN python -m pip install --no-cache-dir --timeout 180 --retries 10 torch==2.3.1+cpu --index-url https://download.pytorch.org/whl/cpu --extra-index-url https://pypi.org/simple
RUN python -m pip install --timeout 180 --retries 10 --prefer-binary \
    numpy==1.26.4 \
    pandas==2.2.2 \
    scikit-learn==1.5.0 \
    fastapi==0.143.0 \
    uvicorn==0.54.0 \
    python-multipart==0.0.32
COPY src/train.py src/train.py
COPY api/ api/
COPY models/exofinder.pt models/exofinder.pt
COPY outputs/training_metrics.json outputs/training_metrics.json
EXPOSE 8000
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
